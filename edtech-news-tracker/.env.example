# Copy this file to .env and fill in your real key. Never commit .env itself.
PARALLEL_API_KEY=your_parallel_api_key_here

# Optional tuning (safe to leave commented out / defaults are sensible)
# MAX_CONCURRENT_REQUESTS=15   # raise this for a faster run if your Parallel.ai plan allows it
# MAX_RETRIES=4
# BACKOFF_BASE_SECONDS=2
# RELEVANCE_REVIEW_THRESHOLD=0.55
# PARALLEL_MODE=basic   # one of: turbo, fast, basic, advanced
# MAX_RESULTS_PER_QUERY=10

# Cost controls: the per-country geography sweep is the expensive part of a
# run (tens of thousands of calls, most finding nothing). Only companies
# whose Category Code (in edtech_tracking_list.xlsx) is in this list get
# the full 82-country sweep; everyone else still gets the 2 cheap official/
# global searches, just not the sweep. Default: A/B/C (English/Language
# Learning, Assessment/Exam, EdTech/Publishing -- the categories where
# local/regional news is most central). Add more letters (comma-separated)
# to widen coverage, or narrow it to cut cost further.
# FULL_SWEEP_CATEGORIES=A,B,C
# A low max_results for the geography sweep specifically costs little in
# practice (there's rarely more than 1-2 genuine local hits per country per
# day) while keeping each of those many calls cheaper.
# GEOGRAPHY_MAX_RESULTS_PER_QUERY=3

# ---- Spend control (hard cap) ----
# BUDGET_USD=25                 # run never spends more than this (estimated); resumes share the ledger
# SEARCH_COST_USD=0.005         # est. $ per Parallel search call -- verify on your plan, set if different
# EXTRACT_COST_USD=0.001        # est. $ per URL full-text extraction
# EXTRACT_RESERVE_FRACTION=0.05 # budget held back for article full-text summaries
# GEO_BATCH_SIZE=auto           # countries per call; auto = smallest size covering ALL countries in budget
# GEO_BATCH_MAX=10
# GEO_PRIORITY_COUNTRIES=India,United States,...  # searched first if the budget can't cover everything
